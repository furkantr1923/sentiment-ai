<Project>
  <!-- Tüm projeler için ortak derleme ayarları -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Furkan</Company>
    <Authors>Furkan</Authors>
    <Product>SENTIMENT AI</Product>
    <Copyright>© 2026 Furkan</Copyright>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <NeutralLanguage>tr-TR</NeutralLanguage>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
