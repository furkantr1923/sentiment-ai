<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SENTIMENT AI ortak iş mantığı.
    Arayüzden bağımsızdır: Windows, Android ve test projeleri bu kütüphaneyi kullanır.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SentimentAI.Core</RootNamespace>
    <AssemblyName>SentimentAI.Core</AssemblyName>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- HttpClientFactory: yönetilen HTTP istemcileri -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- PDF metin çıkarımı (saf .NET, yerel kod yok) -->
    <PackageReference Include="PdfPig" Version="0.1.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SentimentAI.Core.Tests" />
  </ItemGroup>

</Project>
